# - VITE_API_URL: Địa chỉ API của Backend (mặc định để trống '' nếu dùng proxy của Vite,
#   hoặc điền 'http://localhost:5000/api' nếu gọi trực tiếp).
# - VITE_SOCKET_URL: Địa chỉ máy chủ Socket.IO Backend (thường là 'http://localhost:5000').
# ==============================================================================

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME="UniEat - Căng Tin Đại Học"
