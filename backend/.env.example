# ==============================================================================
# UNIEAT CAMPUS BACKEND - CẤU HÌNH MÔI TRƯỜNG CHO MÁY CÁ NHÂN (LOCAL MACHINE)
# ==============================================================================
# Hướng dẫn: Đổi tên file này thành .env hoặc chỉnh sửa trực tiếp các giá trị dưới đây
# để phù hợp với môi trường cài đặt trên máy của bạn (XAMPP, Laragon, Docker, v.v.).

# 1. CỔNG CHẠY SERVER BACKEND
# Mặc định máy cá nhân nên để cổng 5000 (tránh đụng cổng 3000 hoặc 80 của Apache)
PORT=5000
NODE_ENV=development

# 2. CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU MYSQL TRÊN MÁY CỦA BẠN
# [CHÚ THÍCH CẤU HÌNH]:
# - DB_HOST: Thường là 'localhost' hoặc '127.0.0.1'
# - DB_PORT: Mặc định MySQL là 3306 (nếu dùng XAMPP bị đổi cổng thì sửa theo cổng đó, ví dụ 3307)
# - DB_USER: Mặc định trên XAMPP / Laragon là 'root'
# - DB_PASSWORD: Mặc định XAMPP để trống '', còn nếu bạn đặt mật khẩu cho root thì điền vào đây
# - DB_NAME: Tên database bạn tạo trong phpMyAdmin/HeidiSQL/Workbench (ví dụ: 'unieat_db')
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unieat_db

# 3. CẤU HÌNH BẢO MẬT & JWT (JSON WEB TOKEN)
# [CHÚ THÍCH CẤU HÌNH]:
# Chuỗi bí mật dùng để ký và giải mã mã đăng nhập token. Bạn có thể đổi thành chuỗi bất kỳ dài tối thiểu 32 ký tự.
JWT_SECRET=unieat_campus_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# 4. CẤU HÌNH CORS (CHO PHÉP FRONTEND TRUY CẬP TỪ MÁY LOCAL)
# Địa chỉ URL của Frontend ReactJS trên máy bạn (thường chạy cổng 5173 của Vite hoặc 3000)
CLIENT_URL=http://localhost:5173

# 5. CẤU HÌNH CLOUDINARY (LƯU TRỮ ẢNH MÓN ĂN & BANNER ĐÁM MÂY)
# [CHÚ THÍCH CẤU HÌNH]:
# Đăng ký tài khoản miễn phí tại https://cloudinary.com để lấy 3 thông số này.
# Nếu chưa có tài khoản, hệ thống sẽ sử dụng bộ tối ưu ảnh CDN dự phòng.
CLOUDINARY_CLOUD_NAME=unieat-campus
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# 6. CẤU HÌNH CỔNG THANH TOÁN TRỰC TUYẾN SANDBOX (THỬ NGHIỆM)
# [CHÚ THÍCH CẤU HÌNH]:
# Cấu hình cổng VNPay Sandbox (https://sandbox.vnpayment.vn)
VNPAY_TMN_CODE=UNIEAT01
VNPAY_HASH_SECRET=SECRET_VNPAY_KEY_FOR_LOCAL_DEV
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/orders

# Cấu hình ví MoMo Sandbox (https://developers.momo.vn)
MOMO_PARTNER_CODE=MOMO_UNIEAT
MOMO_ACCESS_KEY=MOMO_DEV_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_DEV_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# 7. CẤU HÌNH REDIS (CACHE TỐC ĐỘ CAO, SESSION, RATE LIMITING & PUBSUB)
# [CHÚ THÍCH CẤU HÌNH]:
# - REDIS_ENABLED: 'false' khi chưa cài Redis (hệ thống tự fallback in-memory an toàn).
#   Đổi thành 'true' khi đã cài Redis qua Docker/Windows/Linux để kích hoạt cache.
# - REDIS_HOST: 'localhost' hoặc '127.0.0.1'
# - REDIS_PORT: 6379 (cổng mặc định của Redis)
# - REDIS_PASSWORD: Để trống nếu không đặt mật khẩu cho Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

